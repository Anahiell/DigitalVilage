{
  "name": "digital-village",
  "version": "0.2.2",
  "private": true,
  "description": "Digital Village \u0432\u0402\u201d live multiplayer Erasmus+ educational simulation",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test tests/*.test.js",
    "load-test": "node tests/load.mjs",
    "doctor": "node deploy/doctor.mjs --public",
    "test:e2e": "node --test tests/*.e2e.mjs",
    "workshop": "node deploy/start-workshop.mjs",
    "test:monitor": "node --test tests/participant-monitor.test.js",
    "test:session": "node --test tests/global-pause.test.js tests/session-load.test.js",
    "test:e2e:session": "node --test tests/session-controls.e2e.mjs",
    "load-test:handler": "node --test tests/session-load.test.js",
    "load-test:hour": "node tests/hour-load.mjs"
  },
  "dependencies": {
    "nodemailer": "^10.1.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
