{
  "name": "digital-village",
  "version": "0.2.1",
  "private": true,
  "description": "Digital Village — live multiplayer Erasmus+ educational simulation",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test tests/*.test.js",
    "load-test": "node tests/load.mjs",
    "doctor": "node deploy/doctor.mjs --public"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "nodemailer": "^10.1.2"
  }
}
