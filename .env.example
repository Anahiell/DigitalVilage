# Copy to .env; use a long random admin password and random PIN pepper.
HOST=127.0.0.1
PORT=3000
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
PIN_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_DAYS=2
PRIVACY_CONTACT=organisers@example.org
# For local rehearsal only. PIN letters will be visible in admin outbox, NEVER enable for public deployments.
DEV_EMAIL_OUTBOX=1
# For Gmail SMTP: create a separate Google account, enable 2FA, generate an app password.
# Set both variables to enable delivery. SMTP support is installed by npm ci.
# SMTP_EMAIL=your-teaching-address@gmail.com
# SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional custom SMTP server (defaults to Gmail TLS on 465):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Optional primary sender via HTTPS. Requires your own verified sending domain.
# When both Resend and SMTP are set, real SMTP is the fallback on API failure.
# RESEND_API_KEY=your-private-api-key
# EMAIL_FROM=Digital Village <workshop@your-verified-domain>
# Optional separate account for the single opt-in security exercise.
# A configured exercise sender never falls back into the PIN account.
# EXERCISE_SMTP_EMAIL=your-separate-teaching-account@gmail.com
# EXERCISE_SMTP_APP_PASSWORD=your-private-app-password
# EXERCISE_SMTP_HOST=smtp.gmail.com
# EXERCISE_SMTP_PORT=465
# PUBLIC_BASE_URL=https://your-https-address.example
# Set to 1 only when reverse proxy provides HTTPS and sends X-Forwarded-Proto securely.
TRUST_PROXY=0
