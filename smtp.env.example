# New installation: copy this to smtp.env, fill SMTP credentials and the EXISTING public URL.
# Existing Pi installation: update only matching SMTP variables in your existing .env.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
DEV_EMAIL_OUTBOX=0
SMTP_EMAIL=YOUR_ACCOUNT@gmail.com
SMTP_APP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Use your current Tailscale Funnel / custom domain. No Funnel changes are needed.
PUBLIC_BASE_URL=https://YOUR_EXISTING_GAME_ADDRESS
PRIVACY_CONTACT=YOUR_CONTACT_EMAIL
# Optional different account for the phishing exercise. Leave BOTH empty to share SMTP.
EXERCISE_SMTP_EMAIL=
EXERCISE_SMTP_APP_PASSWORD=
EXERCISE_SMTP_HOST=smtp.gmail.com
EXERCISE_SMTP_PORT=465
# Generated automatically on a NEW installation by npm run workshop.
# Never replace existing Pi ADMIN_PASSWORD, PIN_PEPPER or DB_PATH with new values.
